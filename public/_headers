/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://storage.googleapis.com https://cloudflareinsights.com; frame-src https://neuroglancer-demo.appspot.com; base-uri 'self'; form-action 'self'

/data/*
  Cache-Control: public, max-age=31536000, immutable
/data-regions-*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=3600, must-revalidate
/app.js
  Cache-Control: public, max-age=3600, must-revalidate
/atlas-layers.js
  Cache-Control: public, max-age=3600, must-revalidate

/og-image.jpg
  Cache-Control: public, max-age=604800, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, immutable
/favicon.svg
  Cache-Control: public, max-age=604800, immutable
